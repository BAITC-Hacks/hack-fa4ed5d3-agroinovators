{
  "name": "taskatlas-ai",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.11.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10.9.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}